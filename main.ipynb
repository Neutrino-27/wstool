def poblar_campos_login():

for widget in frame_inputs.winfo_children(): widget.destroy()

inputs_dinamicos.clear()

lbl_modo_config.config(text="Parameters (Mode: REQUIRED SYSTEM LOGIN)")

for p in configuracion_login["params"]:

row = tk.Frame(frame_inputs); row.pack(fill=tk.X, pady=2)

tk.Label(row, text=f"{p}:", width=16, anchor="w").pack(side=tk.LEFT)

ent = tk.Entry(row)

ent.pack(side=tk.LEFT, fill=tk.X, expand=True)

ent.insert(tk.END, str(configuracion_login["default"].get(p, "")))

inputs_dinamicos[p] = ent

def cargar_parametros_operacion(event):

global is_logged_in

if not is_logged_in:

messagebox.showwarning("Sesión Requerida", "Debe completar exitosamente el inicio de sesión primero.")

lista.selection_clear(0, tk.END); return

seleccion = lista.curselection()

if not seleccion: return

for widget in frame_inputs.winfo_children(): widget.destroy()

inputs_dinamicos.clear()

nombre_config = lista.get(seleccion[0])

config = configuraciones_operaciones[nombre_config]

lbl_modo_config.config(text=f"Parameters (Mode: AUTHORIZED / {config['method']})")

for p in config["params"]:

row = tk.Frame(frame_inputs); row.pack(fill=tk.X, pady=2)

tk.Label(row, text=f"{p}:", width=16, anchor="w").pack(side=tk.LEFT)

ent = tk.Text(row, height=5, font=('Consolas', 9)) if p in ["isn_list_batch", "data"] else tk.Entry(row)

ent.pack(side=tk.LEFT, fill=tk.X, expand=True)

ent.insert(tk.END, str(config["default"].get(p, "")))

inputs_dinamicos[p] = ent

def ejecutar_solo_login():

global is_logged_in, credenciales_sesion

if is_logged_in:

txt_output.insert(tk.END, f"\n[!] Aviso: Ya existe una sesión activa autorizada en memoria.\n"); return

gui_data = {k: v.get().strip() for k, v in inputs_dinamicos.items() if isinstance(v, tk.Entry)}

txt_output.insert(tk.END, f"\n--- [{datetime.now().strftime('%H:%M:%S')}] Global Login Request ---\n")

txt_output.insert(tk.END, " > Validando privilegios de acceso en WTSP_LOGINOUT...\n")

txt_output.update_idletasks()

login_exitoso, msg_login = ejecutar_soap_login(URL_WEB_SERVICE, gui_data)

if login_exitoso:

is_logged_in = True

credenciales_sesion = gui_data.copy()

txt_output.insert(tk.END, f" [SUCCESS] Sesión Autorizada por SFIS: {msg_login}\n")

txt_output.insert(tk.END, " [INFO] Seleccione una operación en la lista izquierda para comenzar.\n")

lista.config(state=tk.NORMAL)

for widget in frame_inputs.winfo_children(): widget.destroy()

inputs_dinamicos.clear()

lbl_modo_config.config(text="Parameters (Authorized: Select Operation on the left list)")

else:

is_logged_in = False

txt_output.insert(tk.END, f" [FAILED] Autenticación Rechazada por SFIS: {msg_login}\n", "error")

txt_output.see(tk.END)

def ejecutar_test():

global is_logged_in, credenciales_sesion

if not is_logged_in:

messagebox.showwarning("Autenticación Requerida", "Debe iniciar sesión primero presionando 'VERIFY LOGIN ONLY'."); return

seleccion = lista.curselection()

if not seleccion:

messagebox.showwarning("Aviso", "Seleccione una operación (WTSP_RESULT / MASSDATA) de la lista izquierda."); return

nombre_config = lista.get(seleccion[0])

config = configuraciones_operaciones[nombre_config]

gui_data = {k: (v.get("1.0", tk.END).strip() if isinstance(v, tk.Text) else v.get().strip()) for k, v in inputs_dinamicos.items()}

payload_transaccion = {

"programId": credenciales_sesion.get("programId", ""),

"programPassword": credenciales_sesion.get("programPassword", "")

}

for p in config["params"]:

if p != "isn_list_batch": payload_transaccion[p] = gui_data.get(p, "")

txt_output.insert(tk.END, f"\n--- [{datetime.now().strftime('%H:%M:%S')}] {config['method']} Transaction ---\n")

try:

if config.get("type") == "sfis_result" and gui_data.get("isn_list_batch"):

lista_isn = [line.strip() for line in gui_data["isn_list_batch"].split('\n') if line.strip()]

txt_output.insert(tk.END, f" Iniciando Procesamiento por lote para {len(lista_isn)} unidades...\n")

for isn_item in lista_isn:

txt_output.insert(tk.END, f" > Procesando {isn_item}...")

txt_output.update_idletasks()

payload_transaccion["ISN"] = isn_item

res_raw = enviar_peticion_soap_oficial(URL_WEB_SERVICE, payload_transaccion)

guardar_log(f"Batch-{isn_item}", URL_WEB_SERVICE, payload_transaccion, res_raw)

clean = extraer_string_soap(res_raw)

es_error = "OK" not in clean.upper() and "PASS" not in clean.upper() and "TRUE" not in clean.upper()

txt_output.insert(tk.END, f" {clean}\n", "error" if es_error else None)

txt_output.see(tk.END)

else:

if config.get("type") != "sfis_batch" and not gui_data.get("ISN"):

messagebox.showerror("Error", "El campo ISN es obligatorio."); return

res_raw = enviar_peticion_soap_datos(URL_WEB_SERVICE, config["method"], payload_transaccion)

guardar_log(f"Single-{config['method']}", URL_WEB_SERVICE, payload_transaccion, res_raw)

clean = extraer_respuesta_metodo(config["method"], res_raw)

es_error = "OK" not in clean.upper() and "PASS" not in clean.upper() and "TRUE" not in clean.upper()

txt_output.insert(tk.END, f" [Server Response]: {clean}\n", "error" if es_error else None)

except Exception as e:

txt_output.insert(tk.END, f"EXCEPTION: {str(e)}\n", "error")

txt_output.see(tk.END)

