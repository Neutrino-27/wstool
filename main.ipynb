# ==============================================================================

# --- FUNCIONES PURAS DE COMUNICACIÓN DE RED (SOAP EMULATOR) ---

# ==============================================================================

def guardar_log(nombre_func, url, params, respuesta):

fecha_hoy = datetime.now().strftime("%Y%m%d")

with open(f"log_pruebas_{fecha_hoy}.log", "a", encoding="utf-8") as f:

f.write(f"{'='*60}\nDATE/TIME: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\nFUNCTION: {nombre_func}\nURL: {url}\nCLIENT REQUEST DATA:\n")

for k, v in params.items(): f.write(f" {k}: {v}\n")

f.write(f"SERVER RESPONSE:\n{respuesta}\n{'='*60}\n\n")

def ejecutar_soap_login(url, variables):

soap_body = f"""<?xml version="1.0" encoding="utf-8"?>

<soap:Envelope xmlns:xsi="{XMLNS_XSI_STANDARD}" xmlns:xsd="{XMLNS_XSD_STANDARD}" xmlns:soap="{XMLNS_SOAP_ENVELOPE}">

<soap:Body>

<WTSP_LOGINOUT xmlns="{XML_NAMESPACE_SFC}">

<programId>{variables.get('programId', '')}</programId>

<programPassword>{variables.get('programPassword', '')}</programPassword>

<op>{variables.get('op', '')}</op>

<password>{variables.get('password', '')}</password>

<device>{variables.get('device', '')}</device>

<TSP>{variables.get('TSP', '')}</TSP>

<status>{variables.get('status', '1')}</status>

</WTSP_LOGINOUT>

</soap:Body>

</soap:Envelope>"""

headers = {

"Host": HEADER_HOST_NET,

"Content-Type": "text/xml; charset=utf-8",

"SOAPAction": f"{SOAP_ACTION_BASE}WTSP_LOGINOUT"

}

try:

res = requests.post(url, data=soap_body, headers=headers, timeout=15, verify=False)

res.encoding = 'utf-8'

guardar_log("WTSP_LOGINOUT_REQ", url, variables, res.text)

match = re.search(r'<WTSP_LOGINOUTResult[^>]*>(.*?)</WTSP_LOGINOUTResult>', res.text, re.DOTALL)

if match:

respuesta_servidor = match.group(1).strip()

if any(x in respuesta_servidor.upper() for x in ["OK", "TRUE", "PASS", "WELCOME"]):

return True, respuesta_servidor

return False, respuesta_servidor

return False, "Login rechazado/Sin respuesta legible"

except Exception as e:

return False, f"Error de red: {str(e)}"

def enviar_peticion_soap_oficial(url, variables):

"""Envía la transacción estructurada como SOAP 1.1 al método WTSP_RESULT"""

xml_elements = ""

target_keys = ["programId", "programPassword", "ISN", "error", "device", "TSP", "data", "status", "CPKFlag"]

for k in target_keys:

v = variables.get(k, "")

if k == "data":

v = str(v).replace('&', '&amp;').replace('<', '&lt;').replace('>', '&gt;').replace('"', '&quot;').replace("'", '&apos;')

xml_elements += f"<{k}>{v}</{k}>"

soap_envelope = f"""<?xml version="1.0" encoding="utf-8"?>

<soap:Envelope xmlns:xsi="{XMLNS_XSI_STANDARD}" xmlns:xsd="{XMLNS_XSD_STANDARD}" xmlns:soap="{XMLNS_SOAP_ENVELOPE}">

<soap:Body><WTSP_RESULT xmlns="{XML_NAMESPACE_SFC}">{xml_elements}</WTSP_RESULT></soap:Body>

</soap:Envelope>"""

headers = {"Host": HEADER_HOST_NET, "Content-Type": "text/xml; charset=utf-8", "SOAPAction": f"{SOAP_ACTION_BASE}WTSP_RESULT"}

res = requests.post(url, data=soap_envelope, headers=headers, timeout=15, verify=False)

res.encoding = 'utf-8'

return res.text

def enviar_peticion_soap_datos(url, metodo, variables):

xml_elements = ""

for k, v in variables.items():

if k == "data" or k.startswith("data"):

v = str(v).replace('&', '&amp;').replace('<', '&lt;').replace('>', '&gt;').replace('"', '&quot;').replace("'", '&apos;')

xml_elements += f"<{k}>{v}</{k}>"

soap_envelope = f"""<?xml version="1.0" encoding="utf-8"?>

<soap:Envelope xmlns:xsi="{XMLNS_XSI_STANDARD}" xmlns:xsd="{XMLNS_XSD_STANDARD}" xmlns:soap="{XMLNS_SOAP_ENVELOPE}">

<soap:Body><{metodo} xmlns="{XML_NAMESPACE_SFC}">{xml_elements}</{metodo}></soap:Body>

</soap:Envelope>"""

headers = {"Host": HEADER_HOST_NET, "Content-Type": "text/xml; charset=utf-8", "SOAPAction": f"{SOAP_ACTION_BASE}{metodo}"}

res = requests.post(url, data=soap_envelope, headers=headers, timeout=15, verify=False)

res.encoding = 'utf-8'

return res.text

def extraer_string_soap(xml_text):

if not xml_text: return "Respuesta Vacía"

match_soap = re.search(r'<WTSP_RESULTResult[^>]*>(.*?)</WTSP_RESULTResult>', xml_text, re.DOTALL)

if match_soap: return match_soap.group(1).strip()

match_fault = re.search(r'<faultstring[^>]*>(.*?)</faultstring>', xml_text, re.DOTALL)

if match_fault: return f"Error del Servidor: {match_fault.group(1).strip()}"

return re.sub('<[^<]+?>', '', xml_text).replace('\n', ' ').strip()[:120]

def extraer_respuesta_metodo(metodo, xml_text):

if not xml_text: return "Respuesta Vacía"

match_soap = re.search(f'<{metodo}Result[^>]*>(.*?)</{metodo}Result>', xml_text, re.DOTALL | re.IGNORECASE)

if match_soap: return match_soap.group(1).strip()

match_fault = re.search(r'<faultstring[^>]*>(.*?)</faultstring>', xml_text, re.DOTALL)

if match_fault: return f"Error de Servidor: {match_fault.group(1).strip()}"

return re.sub('<[^<]+?>', '', xml_text).replace('\n', ' ').strip()[:120]

