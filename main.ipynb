m2 = tk.PanedWindow(m1, orient=tk.VERTICAL, sashrelief=tk.RAISED, sashwidth=4)

m1.add(m2)

frame_centro = tk.Frame(m2, padx=10, pady=10)

lbl_modo_config = tk.Label(frame_centro, text="Parameters", font=('Arial', 10, 'bold'))

lbl_modo_config.pack()

frame_inputs = tk.Frame(frame_centro)

frame_inputs.pack(fill=tk.BOTH, expand=True, pady=10)

tk.Button(frame_centro, text="RUN TRANSACTION / START BATCH", bg="#28a745", fg="white", font=('Arial', 10, 'bold'), height=2, command=ejecutar_test).pack(fill=tk.X, pady=5)

m2.add(frame_centro, height=400)

frame_derecha = tk.Frame(m2, padx=10, pady=10)

tk.Label(frame_derecha, text="Console Output (SFIS Server Logs)", font=('Arial', 10, 'bold')).pack(anchor="w")

txt_output = tk.Text(frame_derecha, bg="#1e1e1e", fg="#d4d4d4", font=('Consolas', 10))

txt_output.pack(fill=tk.BOTH, expand=True)

txt_output.tag_configure("error", foreground="#ff6b6b")

m2.add(frame_derecha)

# Cargar los parámetros de login fijos en pantalla al arrancar

poblar_campos_login()

root.mainloop()
