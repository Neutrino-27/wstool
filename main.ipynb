# CORRECCIÓN: Creamos el Listbox en modo NORMAL primero para inyectarle los valores estables de forma inmediata

lista = tk.Listbox(frame_izq, exportselection=False, font=('Arial', 9))

lista.pack(fill=tk.BOTH, expand=True, pady=(0, 5))

# CORRECCIÓN: Llenamos los métodos en la interfaz justo aquí para asegurar que no se quede vacío

for k in configuraciones_operaciones.keys():

lista.insert(tk.END, k)

# CORRECCIÓN: Pasamos el Listbox a DISABLED inmediatamente después de llenarla para proteger el flujo del login

lista.config(state=tk.DISABLED)

btn_solo_login = tk.Button(frame_izq, text="VERIFY LOGIN ONLY", bg="#0056b3", fg="white", font=('Arial', 9, 'bold'), height=2, command=ejecutar_solo_login)

btn_solo_login.pack(fill=tk.X)

lista.bind('<<ListboxSelect>>', cargar_parametros_operacion)

